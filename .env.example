# ---- Client (Vite) — public values only ----
# "cloudflare" = use this app's /api (Pages Functions + D1). Empty = demo mode (device only).
VITE_BACKEND=
# OAuth client ID for "Sign in with Google" (public; same value as GOOGLE_CLIENT_ID in wrangler.toml)
VITE_GOOGLE_CLIENT_ID=
# "true" bundles Pro lesson bodies (demo/dev). Set "false" in production so they are served by /api only.
VITE_BUNDLE_PRO_CONTENT=true
# Local testing only: show the dev sign-in form (the API also needs DEV_LOGIN=1 in .dev.vars)
VITE_DEV_LOGIN=
# "true" turns on paid plans (Pro, paywall, plan pages). Empty = everything is free.
VITE_PAID_PLANS=
# Prices in JPY, tax included (leave empty until decided; the UI shows [未定])
VITE_PRICE_MONTHLY_JPY=
VITE_PRICE_YEARLY_JPY=

# ---- Server secrets: NEVER put these here ----
# Local:      .dev.vars (gitignored)  e.g. DEV_LOGIN=1, STRIPE_SECRET_KEY=sk_test_...
# Production: npx wrangler pages secret put STRIPE_SECRET_KEY  (and STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_MONTHLY, STRIPE_PRICE_YEARLY)
